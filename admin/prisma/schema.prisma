generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @db.VarChar(191)
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String? @db.Text
  role String @default("editor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  @@map("ca_users")
}
model Session {
  id String @id @db.VarChar(191)
  token String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String? @db.Text
  userId String @db.VarChar(191)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("ca_sessions")
}
model Account {
  id String @id @db.VarChar(191)
  accountId String
  providerId String
  userId String @db.VarChar(191)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String? @db.Text
  refreshToken String? @db.Text
  idToken String? @db.Text
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@map("ca_accounts")
}
model Verification {
  id String @id @db.VarChar(191)
  identifier String
  value String @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
  @@map("ca_verifications")
}
model Project {
  id String @id @default(cuid())
  slug String @unique
  title String
  description String @db.Text
  status String @default("draft")
  featured Int? @unique
  sortOrder Int @default(0)
  data Json
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, sortOrder])
  @@map("ca_projects")
}
model Document {
  key String @id
  data Json
  version Int @default(1)
  updatedAt DateTime @updatedAt
  @@map("ca_documents")
}
model Revision {
  id String @id @default(cuid())
  entity String
  entityId String
  data Json
  authorId String
  createdAt DateTime @default(now())
  @@index([entity, entityId, createdAt])
  @@map("ca_revisions")
}
model Publication {
  id String @id @default(cuid())
  sequence Int @unique @default(autoincrement())
  snapshot Json
  status String @default("queued")
  message String? @db.Text
  createdBy String
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  @@index([status, sequence])
  @@map("ca_publications")
}
model Redirect {
  slug String @id
  projectId String
  @@map("ca_redirects")
}
model Lead {
  id String @id @default(cuid())
  name String
  email String
  phone String @default("")
  company String @default("")
  service String @default("")
  message String @db.Text
  status String @default("new")
  priority String @default("normal")
  ownerId String?
  budget Decimal? @db.Decimal(12, 2)
  deadline DateTime?
  lostReason String? @db.Text
  tags Json
  source String @default("lp")
  metadata Json
  firstContactAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events LeadEvent[]
  tasks Task[]
  @@index([email])
  @@index([status, createdAt])
  @@index([ownerId, status])
  @@map("ca_leads")
}
model Submission {
  key String @id @db.VarChar(191)
  leadId String
  createdAt DateTime @default(now())
  @@map("ca_submissions")
}
model LeadEvent {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId String?
  type String
  text String @db.Text
  createdAt DateTime @default(now())
  @@index([leadId, createdAt])
  @@map("ca_lead_events")
}
model Task {
  id String @id @default(cuid())
  title String
  leadId String?
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  ownerId String?
  dueAt DateTime
  done Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([done, dueAt])
  @@map("ca_tasks")
}
model Media {
  id String @id @default(cuid())
  name String
  storageKey String @unique
  url String @db.Text
  alt String
  mime String
  size Int
  width Int
  height Int
  createdAt DateTime @default(now())
  @@map("ca_media")
}
model AuditLog {
  id String @id @default(cuid())
  authorId String
  action String
  entity String
  entityId String
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@map("ca_audit")
}
model RateLimit {
  key String @id
  count Int @default(1)
  resetAt DateTime
  @@map("ca_rate_limits")
}
model AuthRateLimit {
  id String @id @default(cuid())
  key String @unique
  count Int
  lastRequest BigInt
  @@map("ca_auth_rate_limits")
}
