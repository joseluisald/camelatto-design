NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=camelatto
DB_PASSWORD=replace-me
DB_NAME=camelatto
# Gerados por db:setup. Em produção, configure segredos de alta entropia.
BETTER_AUTH_SECRET=
PUBLICATION_SECRET=
# Origem pela qual o navegador acessa o painel, sem o caminho.
ADMIN_ORIGIN=http://localhost:4321
LP_ORIGIN=http://localhost:4321
ALLOWED_ORIGINS=http://localhost:4321
# Local storage exige disco persistente; S3 é opcional.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Opcional: webhook HTTPS do pipeline. Callback assinado descrito no README.
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_TOKEN=
# Deploy integrado com Docker/Coolify: a imagem define esses caminhos.
# PUBLISH_RUNTIME_DIR=/data
# STORAGE_PATH=/data/storage
# BACKUP_PATH=/data/backups
# Ative apenas para a primeira instalação em um banco totalmente vazio.
DB_BOOTSTRAP_ON_START=false
