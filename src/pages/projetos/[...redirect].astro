---
import { getSettings } from '@/utils/data';
import { sitePath } from '@/utils/paths';
export function getStaticPaths() {
    const content = getSettings();
    const active = new Set(content.portfolio.projects.map(p => p.slug));
    return (content.redirects || []).filter(r => !active.has(r.from)).map(r => ({ params: { redirect: r.from }, props: { to: r.to } }));
}
const target = sitePath(`projetos/${Astro.props.to}/`);
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0;url=${target}`} /><meta name="robots" content="noindex, follow" /><link rel="canonical" href={new URL(target, Astro.site)} /><title>Projeto atualizado</title></head><body><a href={target}>Acessar o projeto atualizado</a></body></html>
