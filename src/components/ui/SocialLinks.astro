---
import { siteHref, safeEmail } from '@/utils/urls';
import { ArrowUpRight } from '@lucide/astro';
import type { SiteSettings } from '@/models/content';
interface Props { settings: SiteSettings; compact?: boolean; }
const { settings, compact = false } = Astro.props;
const links = compact ? [
    { label: 'LinkedIn', href: siteHref(settings.linkedin) },
    { label: 'Behance', href: siteHref(settings.behance) },
    { label: 'Currículo', href: siteHref(settings.resume) },
    { label: 'E-mail', href: safeEmail(settings.email) },
] : [
    { label: 'LinkedIn', href: siteHref(settings.linkedin) },
    { label: 'E-mail', href: safeEmail(settings.email) },
    { label: 'Currículo (PDF)', href: siteHref(settings.resume) },
    { label: 'Behance', href: siteHref(settings.behance) },
];
---
<ul class:list={['social-links', { 'social-links--compact': compact }]} aria-label="Redes e contato">
    {links.map(link => <li>
        {link.href ? <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            {link.label}
            <ArrowUpRight size={13} aria-hidden="true" />
        </a> : <span>{link.label} <small>[a definir]</small></span>}
    </li>)}
</ul>
