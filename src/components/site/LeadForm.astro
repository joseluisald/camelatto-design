---
import { ArrowUpRight } from '@lucide/astro';
import { sitePath } from '@/utils/paths';
interface Props { privacyNotice?: string; privacyVersion?: string; }
const { privacyNotice = 'Usaremos seu nome, e-mail e mensagem para responder ao seu contato. Não enviaremos comunicações de marketing sem sua autorização.', privacyVersion = '1' } = Astro.props;
const endpoint = import.meta.env.PUBLIC_ADMIN_API_URL || sitePath('admin/api/public/leads');
---
<form class="lead-form" data-lead-form data-endpoint={endpoint} data-privacy-version={privacyVersion}>
    <h3>Conte um pouco sobre seu projeto</h3>
    <div class="lead-fields">
        <label>Seu nome<input name="name" autocomplete="name" required minlength="2" maxlength="200" /></label>
        <label>E-mail<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
        <label>Telefone / WhatsApp <small>(opcional)</small><input name="phone" type="tel" autocomplete="tel" maxlength="50" /></label>
        <label>Empresa <small>(opcional)</small><input name="company" autocomplete="organization" maxlength="200" /></label>
        <label class="lead-full">Como posso ajudar?<select name="service"><option value="">Selecione um interesse</option><option>UI/UX Design</option><option>Product Design</option><option>Pesquisa UX</option><option>Identidade visual</option><option>Outro projeto</option></select></label>
        <label class="lead-full">Sua mensagem<textarea name="message" required minlength="5" maxlength="5000" rows="4"></textarea></label>
    </div>
    <div class="lead-honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <p class="lead-privacy">{privacyNotice}</p>
    <label class="lead-consent"><input type="checkbox" name="marketingConsent" />Quero receber novidades e conteúdos por e-mail. <small>(opcional)</small></label>
    <button type="submit" class="button button--light">Enviar mensagem<ArrowUpRight size={16} aria-hidden="true" /></button>
    <p class="lead-result" role="status" aria-live="polite" data-lead-result></p>
    <noscript>Ative o JavaScript para enviar o formulário ou use um dos links de contato acima.</noscript>
</form>
<script>
    document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach(form => {
        if (form.dataset.initialized) return;
        form.dataset.initialized = 'true';
        let key = crypto.randomUUID();
        const params = new URLSearchParams(window.location.search);
        const utm: Record<string, string> = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(name => { const value = params.get(name); if (value) utm[name] = value.slice(0, 500); });
        try { if (Object.keys(utm).length) sessionStorage.setItem('camelatto-utm', JSON.stringify(utm)); } catch { /* Storage can be disabled. */ }
        form.addEventListener('submit', async event => {
            event.preventDefault();
            const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
            const result = form.querySelector<HTMLElement>('[data-lead-result]')!;
            if (button.disabled) return;
            const fields = new FormData(form);
            let storedUtm = utm;
            try { storedUtm = JSON.parse(sessionStorage.getItem('camelatto-utm') || '{}'); } catch { /* Use this visit's parameters. */ }
            button.disabled = true; result.textContent = 'Enviando sua mensagem…';
            try {
                const response = await fetch(form.dataset.endpoint!, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...Object.fromEntries(fields), marketingConsent: fields.get('marketingConsent') === 'on', idempotencyKey: key, source: 'lp', page: window.location.origin + window.location.pathname, project: window.location.pathname.split('/projetos/')[1]?.split('/')[0] || '', utm: storedUtm, privacyVersion: form.dataset.privacyVersion }) });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'Não foi possível enviar agora. Tente novamente.');
                result.textContent = 'Mensagem enviada! Obrigada pelo contato. Retornarei em breve.';
                form.reset(); key = crypto.randomUUID();
            } catch (error) { result.textContent = error instanceof Error ? error.message : 'Não foi possível enviar. Seus campos foram preservados; tente novamente.'; }
            finally { button.disabled = false; }
        });
    });
</script>
<style>
    .lead-form { position: relative; max-width: 720px; margin-top: 56px; padding-top: 32px; border-top: 1px solid #ffffff25; }
    .lead-form h3 { font-size: 25px; margin-bottom: 24px; }
    .lead-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .lead-fields label { display: grid; gap: 8px; font-size: 13px; }
    .lead-fields small, .lead-consent small { color: #beb7ae; font-size: 11px; }
    .lead-fields input, .lead-fields textarea, .lead-fields select { width: 100%; padding: 12px 14px; color: var(--color-background); background: #ffffff08; border: 1px solid #ffffff30; border-radius: 8px; font: inherit; }
    .lead-fields option { color: #202025; background: #faf7f2; }
    .lead-fields textarea { resize: vertical; }
    .lead-full { grid-column: 1 / -1; }
    .lead-privacy { font-size: 11px; color: #beb7ae; margin-block: 20px 14px; }
    .lead-consent { display: flex; align-items: center; gap: 8px; font-size: 11px; }
    .lead-consent input { accent-color: #d75a86; }
    .lead-result { min-height: 24px; margin-top: 16px; font-size: 13px; }
    .lead-honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
    button:disabled { opacity: 0.6; cursor: wait; }
    @media (max-width: 600px) { .lead-fields { grid-template-columns: 1fr; } .lead-consent { align-items: start; } }
</style>
