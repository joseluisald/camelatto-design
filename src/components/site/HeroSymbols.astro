---
import { Image } from 'astro:assets';
import symbol from '@/assets/favicon.png';
---
<div class="hero-symbols" aria-hidden="true">
    <div class="hero-symbol hero-symbol--primary" data-hero-parallax>
        <div data-motion-spin="90"><Image src={symbol} alt="" widths={[480, 840]} sizes="(max-width: 767px) 90vw, 64vw" format="webp" loading="eager" /></div>
    </div>
    <div class="hero-symbol hero-symbol--secondary" data-hero-parallax>
        <div data-motion-spin="-70"><Image src={symbol} alt="" widths={[320, 620]} sizes="40vw" format="webp" loading="lazy" /></div>
    </div>
</div>

<style>
    .hero-symbols { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
    .hero-symbol { position: absolute; mix-blend-mode: multiply; }
    .hero-symbol--primary { top: 2%; right: -12%; width: min(64vw, 900px); opacity: 0.09; }
    .hero-symbol--secondary { bottom: -24%; left: -10%; width: min(40vw, 620px); opacity: 0.055; }
    .hero-symbol img { display: block; width: 100%; height: auto; }
    :global(html[data-banner-theme="dark"]) .hero-symbol { mix-blend-mode: screen; }
    :global(html[data-banner-theme="dark"]) .hero-symbol img { filter: grayscale(1) invert(1); }
    @media (max-width: 767px) {
        .hero-symbol--primary { top: 10%; right: -35%; width: 100vw; opacity: 0.07; }
        .hero-symbol--secondary { bottom: -8%; left: -25%; width: 75vw; opacity: 0.04; }
    }
</style>
