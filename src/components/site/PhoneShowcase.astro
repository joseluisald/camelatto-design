---
import { ArrowUpRight } from '@lucide/astro';
import ProjectPhone from './ProjectPhone.astro';
import type { Project } from '@/utils/data';
interface Props { projects: Project[]; }
const { projects } = Astro.props;
---
<div class="phone-showcase" role="group" aria-label="Projetos em destaque: passe o mouse ou use o teclado para ver os detalhes" data-motion="reveal">
    <div class="phone-halo" aria-hidden="true"></div>
    <div class="phone-track">
    {projects.slice(0, 3).map((project, index) => <div class:list={['phone-position', `phone-position--${index + 1}`, { 'is-selected': index === 0 }]} :class={`{ 'is-selected': activeIndex === ${index} }`}>
        <ProjectPhone project={project} index={index} showcase />
    </div>)}
    </div>
    <div class="phone-caption" aria-hidden="true">
        {projects.map((project, index) => <span x-show={`activeIndex === ${index}`} x-cloak={index !== 0}><span class="caption-id">{project.displayId || project.id}</span> {project.category}<ArrowUpRight size={13} /></span>)}
    </div>
</div>

<style>
    .phone-showcase { position: relative; min-width: 0; isolation: isolate; }
    .phone-halo { position: absolute; z-index: -1; inset: 12% 0 20%; border-radius: 50%; background: radial-gradient(ellipse, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 72%); pointer-events: none; }
    .phone-track { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; gap: clamp(20px, 2.2vw, 32px); padding: 32px 12px 40px; }
    .phone-position { position: relative; min-width: 0; border-radius: 36px; }
    .phone-position::after { content: ''; position: absolute; bottom: -22px; left: 50%; width: 24px; height: 3px; border-radius: 999px; background: var(--color-accent); opacity: 0; transform: translateX(-50%) scaleX(0.4); transition: opacity 240ms, transform 360ms; }
    .phone-position.is-selected::after, .phone-position:focus-within::after { opacity: 1; transform: translateX(-50%) scaleX(1); }
    .phone-caption { display: flex; justify-content: center; width: fit-content; max-width: 100%; margin: 8px auto 0; padding: 10px 16px; border: 1px solid var(--color-line); border-radius: 999px; background: var(--color-background); font-size: 12px; }
    .phone-caption > span { display: flex; align-items: center; gap: 6px; }
    .caption-id, .phone-caption svg { color: var(--color-accent); }
    @media (max-width: 1100px) { .phone-showcase { width: 100%; max-width: 840px; margin-inline: auto; } }
    @media (max-width: 700px) {
        .phone-track { display: flex; gap: 28px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 12px; overscroll-behavior-x: contain; scrollbar-width: thin; scrollbar-color: var(--color-accent) var(--color-surface); }
        .phone-position { flex: 0 0 min(232px, 78vw); scroll-snap-align: start; }
        .phone-caption { margin-top: 16px; font-size: 11px; }
    }
    @media (prefers-reduced-motion: reduce) { .phone-position::after { transition: none; } }
</style>
