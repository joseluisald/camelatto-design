---
import { ArrowUpRight } from '@lucide/astro';
import TagList from '@/components/ui/TagList.astro';
import type { Project } from '@/utils/data';
interface Props { project: Project; }
const { project } = Astro.props;
---
<article class="project-card" data-motion="reveal">
        <div class="project-meta eyebrow"><span>{project.id} — {project.category}</span><span>{project.year}</span></div>
        <h3><button class="project-title-button" type="button" data-project-id={project.id} data-cursor="view" @click="openPreview($event.currentTarget.dataset.projectId)" aria-haspopup="dialog" aria-controls="project-preview">{project.title}</button></h3>
        <p class="project-description">{project.description}</p>
        <p class="project-contribution">Contribuição: {project.contribution}</p>
        <TagList items={project.tags} />
        <div class="project-card-actions">
            <button class="project-cta" type="button" data-project-id={project.id} data-cursor="view" @click="openPreview($event.currentTarget.dataset.projectId)" aria-haspopup="dialog" aria-controls="project-preview">Explorar projeto<ArrowUpRight size={14} aria-hidden="true" /></button>
            <a class="project-case-link" href={`${import.meta.env.BASE_URL}projetos/${project.slug}/`}>Estudo de caso</a>
        </div>
</article>
