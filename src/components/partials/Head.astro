---
import { getImage } from 'astro:assets';
import { SITE_ENV } from 'astro:env/server';
import faviconSource from '@/assets/favicon.png';
import type { SiteSettings, Seo } from '@/models/content';
import { siteHref, serializeJsonLd } from '@/utils/urls';

interface Props {
  settings: SiteSettings;
  seo?: Seo;
  sharer?: string | { src: string };
}
const { settings, seo, sharer } = Astro.props;
const siteURL = Astro.site!;
const favicon = await getImage({ src: faviconSource, width: 64, format: 'png' });
const faviconURL = favicon.src;
const siteName = settings.name;
const title = seo?.title || settings.title;
const description = seo?.description ?? settings.description;
const keywords = seo?.keywords ?? settings.keywords;
const robots = SITE_ENV === 'production' ? (seo?.robots || settings.robots || 'index, follow') : 'noindex, nofollow';
const canonicalHref = new URL(Astro.url.pathname, siteURL).href;
const imageSrc = seo?.ogImage || (typeof sharer === 'string' ? sharer : sharer?.src);
const safeImage = imageSrc ? siteHref(imageSrc) : '';
const imageUrl = safeImage ? new URL(safeImage, siteURL).href : undefined;
const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteName,
  description,
  url: new URL(import.meta.env.BASE_URL, siteURL).href,
};
---
<head>
    <meta charset="UTF-8" />
    <script is:inline>
        try {
            document.documentElement.dataset.bannerTheme = localStorage.getItem('camelatto-banner-theme') === 'dark' ? 'dark' : 'light';
        } catch {
            document.documentElement.dataset.bannerTheme = 'light';
        }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalHref} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}

    <!-- Twitter -->
    <meta property="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {imageUrl && <meta property="twitter:image" content={imageUrl} />}

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" href={faviconURL} />

    <!-- Schema.org (Structured Data para o Google) -->
    <script type="application/ld+json" set:html={serializeJsonLd(schemaOrg)} />
</head>
