---
import { Menu, X } from '@lucide/astro';
import BrandLogo from '@/components/ui/BrandLogo.astro';
import type { SiteSettings } from '@/utils/data';
interface Props { settings: SiteSettings; navigation: { label: string; href: string }[]; }
const { settings, navigation } = Astro.props;
---

<header class="site-header" @keydown.escape.window="menuOpen = false">
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <div class="container header-inner" data-motion="down">
        <a class="wordmark" href={import.meta.env.BASE_URL} aria-label={`${settings.name} — início`}><BrandLogo /></a>
        <nav class="desktop-nav" aria-label="Principal">
            {navigation.map(link => <a href={`${import.meta.env.BASE_URL}${link.href.replace(/^\//, '')}`}>{link.label}</a>)}
        </nav>
        <button class="menu-toggle" type="button" @click="menuOpen = !menuOpen" :aria-expanded="menuOpen" aria-controls="mobile-navigation" aria-label="Abrir ou fechar menu">
            <span x-show="!menuOpen"><Menu size={22} aria-hidden="true" /></span>
            <span x-cloak x-show="menuOpen"><X size={22} aria-hidden="true" /></span>
        </button>
    </div>
    <nav id="mobile-navigation" class="mobile-nav container" aria-label="Navegação móvel" x-cloak x-show="menuOpen" @click="menuOpen = false">
        {navigation.map(link => <a href={`${import.meta.env.BASE_URL}${link.href.replace(/^\//, '')}`}>{link.label}</a>)}
    </nav>
</header>
