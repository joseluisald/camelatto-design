---
import type { SiteSettings } from '@/utils/data';
import BrandLogo from '@/components/ui/BrandLogo.astro';
interface Props { settings: SiteSettings; }
const { settings } = Astro.props;

---

<footer class="site-footer">
    <div class="container footer-inner">
        <div class="footer-brand" data-motion="reveal">
            <a href={import.meta.env.BASE_URL} aria-label={`${settings.name} — início`}>
                <BrandLogo />
            </a>
            <p>© {new Date().getFullYear()} {settings.name}</p>
        </div>
        <div class="footer-meta" data-motion="reveal" data-motion-delay="0.08">
            <p>{settings.role}</p>
            <p>Desenvolvido por <a href={settings.developer.url} target="_blank" rel="noopener noreferrer">{settings.developer.name} ↗</a></p>
        </div>
    </div>
</footer>

